# Copy to .env (git-ignored) and fill in. Only ./run.sh reads it, for its own process:
# nothing here reaches your shell or other projects.
# Exxeta LiteLLM proxy: a token as Bearer auth, the proxy URL, the proxy's model name.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://ai.exxeta.info
AGENT_MODEL=claude-opus-5.5
# Direct Anthropic API instead: delete the three lines above and set ANTHROPIC_API_KEY=
