<!--
  A robot arm with ONE motor: a shoulder joint, an arm, a hand.
  A humanoid is ~29 of these joint+motor pairs.

  What you see in the viewer:
    grey post         = the robot's body (fixed)
    yellow cylinder   = the SHOULDER JOINT, with the motor inside
    blue arm + hand   = the moving part
    green ghost arm   = the TARGET: where we want the arm to be
-->
<mujoco model="one-joint-arm">
  <!-- one physics step = 2 ms, so 500 steps per simulated second -->
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <global offwidth="800" offheight="600"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.6 0.75 0.95" rgb2="0.95 0.95 1" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.8 0.8 0.8" rgb2="0.7 0.7 0.7" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="6 6"/>
  </asset>

  <worldbody>
    <light pos="0 -1.5 2.5" dir="0 0.5 -1"/>
    <geom name="floor" type="plane" size="1.5 1.5 0.1" material="grid"/>

    <!-- the robot's body: fixed to the world -->
    <geom name="body" type="box" pos="0 0.12 0.55" size="0.08 0.06 0.55" rgba="0.45 0.45 0.5 1"/>

    <!-- the arm. Its origin is the shoulder, 1 m above the floor -->
    <body name="arm" pos="0 0 1">
      <!-- the joint: rotates around the y axis -->
      <joint name="shoulder" type="hinge" axis="0 1 0" damping="0.05"/>
      <geom name="shoulder_marker" type="cylinder" fromto="0 -0.05 0 0 0.06 0" size="0.05"
            rgba="1 0.8 0.1 1" density="1" contype="0" conaffinity="0"/>
      <!-- geoms give the arm its shape and its mass (from their volume) -->
      <geom name="upper_arm" type="capsule" fromto="0 0 0 0 0 -0.45" size="0.03" rgba="0.2 0.4 0.9 1"/>
      <geom name="palm" type="box" pos="0 0 -0.49" size="0.05 0.03 0.04" rgba="0.15 0.3 0.75 1"/>
      <geom name="finger1" type="box" pos="0.035 0 -0.57" size="0.012 0.025 0.04" rgba="0.15 0.3 0.75 1"/>
      <geom name="finger2" type="box" pos="-0.035 0 -0.57" size="0.012 0.025 0.04" rgba="0.15 0.3 0.75 1"/>
    </body>

    <!-- the target ghost: just a picture, moved by our code, touches nothing -->
    <body name="target" mocap="true" pos="0 0 1">
      <geom type="capsule" fromto="0 0 0 0 0 -0.6" size="0.015"
            rgba="0.1 0.8 0.2 0.6" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <actuator>
    <!-- the motor. ctrl = torque in newton-metres, max 20. The controller sets it. -->
    <motor name="motor_torque_AUTO" joint="shoulder" ctrlrange="-20 20"/>
    <!-- not a motor (gear="0"): only a slider in the viewer so you can set the target -->
    <general name="target_angle_deg" joint="shoulder" gear="0" ctrlrange="-180 180"/>
  </actuator>
</mujoco>
