<!--
  The world: a floor, two tables, a bottle, and the G1 humanoid.

  Units: meters, kilograms, radians. x = forward, y = left, z = up.
  The robot starts at (0, 0) looking along +x.
  Table A (wood) holds the bottle. Table B (white) has a green "place here" mark.
  Both tables are 0.80 m high: the G1 (1.32 m tall) grasps best at 0.85-0.95 m.
-->
<mujoco model="g1 pick and place">
  <include file="g1_with_hands.xml"/>

  <!-- 2 ms physics step = 500 steps per second, the rate of the G1's motor loop -->
  <option timestep="0.002"/>

  <statistic center="0.8 -0.6 0.7" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-25" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="wood" rgba="0.55 0.38 0.22 1"/>
    <material name="white" rgba="0.9 0.9 0.88 1"/>
    <material name="plastic" rgba="0.2 0.55 0.9 0.9"/>
    <material name="cap" rgba="0.95 0.95 0.95 1"/>
    <material name="target" rgba="0.2 0.8 0.3 0.6"/>
  </asset>

  <default>
    <default class="table">
      <geom type="box" friction="0.8"/>
    </default>
  </default>

  <worldbody>
    <light pos="1 -0.5 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Table A: top 0.6 m x 0.8 m, surface at 0.80 m, front edge at x = 1.3 -->
    <body name="table_a" pos="1.6 0 0">
      <geom name="table_a_top" class="table" size="0.3 0.4 0.02" pos="0 0 0.78" material="wood"/>
      <geom class="table" size="0.025 0.025 0.38" pos="-0.26 -0.36 0.38" material="wood"/>
      <geom class="table" size="0.025 0.025 0.38" pos="-0.26 0.36 0.38" material="wood"/>
      <geom class="table" size="0.025 0.025 0.38" pos="0.26 -0.36 0.38" material="wood"/>
      <geom class="table" size="0.025 0.025 0.38" pos="0.26 0.36 0.38" material="wood"/>
    </body>

    <!-- Table B: top 0.8 m x 0.6 m, surface at 0.80 m, front edge at y = -1.4 -->
    <body name="table_b" pos="1.0 -1.7 0">
      <geom name="table_b_top" class="table" size="0.4 0.3 0.02" pos="0 0 0.78" material="white"/>
      <geom class="table" size="0.025 0.025 0.38" pos="-0.36 -0.26 0.38" material="white"/>
      <geom class="table" size="0.025 0.025 0.38" pos="-0.36 0.26 0.38" material="white"/>
      <geom class="table" size="0.025 0.025 0.38" pos="0.36 -0.26 0.38" material="white"/>
      <geom class="table" size="0.025 0.025 0.38" pos="0.36 0.26 0.38" material="white"/>
    </body>
    <!-- Where the bottle should go: drawn only, nothing touches it -->
    <site name="place_target" pos="1.0 -1.52 0.801" size="0.04 0.001" type="cylinder" material="target"/>

    <!-- The bottle: 0.33 l, 6 cm wide, 18 cm tall, 0.35 kg. Its origin is the middle of the body. -->
    <body name="bottle" pos="1.42 0 0.875">
      <freejoint name="bottle"/>
      <geom name="bottle_body" type="cylinder" size="0.03 0.075" mass="0.33" material="plastic" friction="1.0"/>
      <geom name="bottle_cap" type="cylinder" size="0.014 0.015" pos="0 0 0.09" mass="0.02" material="cap"/>
    </body>
  </worldbody>
</mujoco>
