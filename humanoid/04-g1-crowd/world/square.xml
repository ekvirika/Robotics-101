<!--
  The square: an open 12 m x 12 m place, and the G1 humanoid.

  Units: meters, kilograms, radians. x = east, y = north, z = up.
  The middle of the square is (0, 0). The robot starts on the west side and
  must reach the green mark on the east side.
  The people are not in this file: crowd/world.py adds them, so their number
  is a setting.
-->
<mujoco model="g1 crosses a square">
  <include file="../../03-g1-pick-place/robot/g1_with_hands.xml"/>
  <!-- the robot's 3D shapes live with the robot model -->
  <compiler meshdir="../../03-g1-pick-place/robot/assets"/>

  <!-- 2 ms physics step = 500 steps per second, the rate of the G1's motor loop -->
  <option timestep="0.002"/>

  <statistic center="0 0 0.8" extent="9"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="90" elevation="-50" offwidth="1280" offheight="720"/>
    <map zfar="80"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="paving" builtin="checker" mark="edge" rgb1="0.62 0.6 0.56" rgb2="0.56 0.54 0.5"
      markrgb="0.45 0.45 0.45" width="300" height="300"/>
    <material name="paving" texture="paving" texuniform="true" texrepeat="1 1" reflectance="0.05"/>
    <material name="outside" rgba="0.3 0.36 0.3 1"/>
    <material name="goal" rgba="0.2 0.8 0.3 0.7"/>
    <material name="start" rgba="0.2 0.4 0.9 0.5"/>
  </asset>

  <worldbody>
    <light pos="0 0 12" dir="0 0 -1" directional="true"/>
    <!-- the ground everywhere (the robot and nobody else collides with anything but this) -->
    <geom name="floor" size="0 0 0.05" type="plane" material="outside"/>
    <!-- the paved square, drawn only: one tile is 1 m -->
    <geom name="square" type="box" size="6 6 0.001" pos="0 0 0.001" material="paving" contype="0" conaffinity="0"/>
    <!-- start and goal marks, drawn only -->
    <site name="start" pos="-5 0 0.003" size="0.3 0.001" type="cylinder" material="start"/>
    <site name="goal" pos="5 0 0.003" size="0.3 0.001" type="cylinder" material="goal"/>
  </worldbody>
</mujoco>
